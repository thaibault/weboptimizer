{
    "extends": "./tsconfig.json",

    "compilerOptions": {
        "declaration": true,
        "paths": {
            "@asset/*": ["../../*"],
            "@cascadingStyleSheet/*": ["../../*"],
            "@data/*": ["../../*"],
            "@font/*": ["../../*"],
            "@image/*": ["../../*"],
            "@javaScript/*": ["../../*"],
            "@root/*": ["../../*"],
            "@source/*": ["../../*"],
            "@template/*": ["../../*"]
        }
    },

    "include": [
        "../../*.ts", "../../*.tsx",
        "../../*/*.ts", "../../*/*.tsx",

        "../../assets/src/**/*.ts", "../../assets/src/**/*.tsx",

        "../../src/**/*.ts", "../../src/**/*.tsx",

        "../../test/*.ts", "../../test/*.tsx",
        "../../test/*/*.ts", "../../test/*/*.tsx"
    ]
}
