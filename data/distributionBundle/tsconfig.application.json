{
    "extends": "./tsconfig.json",

    "compilerOptions": {
        "declaration": false,
        "paths": {
            "@asset/*": ["../../src/*"],
            "@cascadingStyleSheet/*": ["../../src/cascadingStyleSheet/*"],
            "@data/*": ["../../src/data/*"],
            "@font/*": ["../../src/font/*"],
            "@image/*": ["../../src/image/*"],
            "@javaScript/*": ["../../src/javaScript/*"],
            "@root/*": ["../../src/*"],
            "@source/*": ["../../src/*"],
            "@template/*": ["../../src/template/*"]
        }
    },

    "include": [
        "../../*.ts", "../../*.tsx",
        "../../*/*.ts", "../../*/*.tsx",

        "../../assets/src/**/*.ts", "../../assets/src/**/*.tsx",

        "../../src/**/*.ts", "../../src/**/*.tsx",

        "../../test/*.ts", "../../test/*.tsx",
        "../../test/*/*.ts", "../../test/*/*.tsx"
    ]
}
